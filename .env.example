# Copy to .env and fill in. .env is git-ignored.

# --- Runner registration ---------------------------------------------------
# Org:  https://github.com/<org>
# Repo: https://github.com/<org>/<repo>
RUNNER_URL=

# Exactly one of the two. PAT is long-lived (needs "Self-hosted runners: read/write");
# TOKEN is the short-lived registration token from Settings > Actions > Runners.
PAT=
# TOKEN=

# Number of runners registered from this VM
RUNNERS=2

# Optional overrides of the image defaults
# GITHUB_RUNNER_VERSION=2.338.0
# GITHUB_RUNNER_NAME=windows_x64_vagrant
# GITHUB_RUNNER_LABELS=windows,win_x64,windows_x64,windows_vagrant_action

# --- VM sizing -------------------------------------------------------------
# MEMORY in MiB, DISK_SIZE in GiB
MEMORY=8000
CPU=4
DISK_SIZE=100
