# Copy to .env and fill in. .env is git-ignored.
#
# Compose reads this file for the ${...} values in docker-compose.yml and also
# bind-mounts it into the VM's shared folder, where oem/install.ps1 reads it.
# Keep one KEY=VALUE per line, comments on their own lines, no "$" in values.

# --- Runner registration ----------------------------------------------------
# Org:  https://github.com/<org>
# Repo: https://github.com/<org>/<repo>
RUNNER_URL=

# Exactly one of the two. PAT is long-lived (needs "Self-hosted runners: read/write");
# TOKEN is the short-lived registration token from Settings > Actions > Runners.
PAT=
# TOKEN=

# Number of runners registered from this VM
RUNNERS=2

# Pin an actions/runner release; empty means the latest release at install time
# GITHUB_RUNNER_VERSION=2.338.0

# Runner name prefix and labels
# GITHUB_RUNNER_NAME=windows_x64_dockur
# GITHUB_RUNNER_LABELS=windows,win_x64,windows_x64,windows_dockur_action
# GITHUB_RUNNER_GROUP=

# Middle part of the runner name (<prefix>_<host id>_<n>). Defaults to the
# Windows computer name, which dockur picks at random on install. Set it when
# you run several VMs against the same org or want names that survive a wipe.
# RUNNER_HOST_ID=

# service (default): Windows services that start with the VM, no desktop.
# interactive: scheduled tasks in the auto-logon desktop session, for jobs
# that drive GUI tooling.
# RUNNER_MODE=service

# Account the runner services run as. Default is the Windows user below.
# Built-in accounts need no password, e.g. NT AUTHORITY\NETWORK SERVICE
# RUNNER_SERVICE_ACCOUNT=

# --- Toolchain --------------------------------------------------------------
# Git, jq, 7-Zip, PowerShell 7 and Chocolatey are always installed.
# INSTALL_VISUAL_STUDIO=true
# enterprise | professional | community | buildtools (see licensing note in README)
# VS_EDITION=enterprise
# Comma-separated workload ids. For buildtools use Microsoft.VisualStudio.Workload.VCTools
# VS_WORKLOADS=Microsoft.VisualStudio.Workload.NativeDesktop
# INSTALL_RTOOLS=true

# --- VM (dockur/windows) ----------------------------------------------------
# All optional; these are the defaults from docker-compose.yml.
# Windows release; 2022 = Windows Server 2022 evaluation
VERSION=2022
# RAM_SIZE and CPU_CORES apply at the next 'docker compose down && up'.
# DISK_SIZE can only grow; C: is extended by install.ps1 at the next boot.
# Never lower it (or drop it after raising it): dockur refuses to shrink the
# disk and the container will not start until the value is put back.
RAM_SIZE=8G
CPU_CORES=4
DISK_SIZE=100G
# QEMU disk I/O backend: native (default, works on any kernel), threads, or
# io_uring (faster, needs kernel 5.12 or newer; older kernels fail at boot).
# DISK_IO=native
# Local administrator created by the unattended install; also the RDP login
WIN_USERNAME=admin
WIN_PASSWORD=runner
